# --- Nguồn nội dung
WP_BASE_URL=https://doppelherz.vn

# --- Thư mục dữ liệu (SQLite, ảnh render, outbox) và tệp tải xuống trên trang "Về bản demo"
DATA_DIR=data
DOWNLOADS_DIR=downloads
REPO_URL=https://github.com/Bachthutruong/doppelherz-workflow

# --- Chế độ đăng: dry_run (ghi payload ra data/outbox, KHÔNG đăng thật) | live
PUBLISH_MODE=dry_run

# --- AI (để trống = dùng bộ sinh dự phòng theo mẫu, không cần mạng)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium
AI_REVIEW=true

# --- Facebook Page (Graph API) — cần quyền pages_manage_posts, pages_read_engagement
FB_PAGE_ID=
FB_PAGE_TOKEN=
FB_GRAPH_VERSION=v27.0

# --- Pinterest API v5 — scope: boards:read, boards:write, pins:read, pins:write
PINTEREST_TOKEN=
# Sandbox khi chờ Standard access: https://api-sandbox.pinterest.com/v5
PINTEREST_API_BASE=https://api.pinterest.com/v5
# Tên bảng (robot chọn theo chủ đề) -> board_id; "default" dùng khi không khớp
PINTEREST_BOARDS={"Sức khỏe trẻ em":"","Mẹ bầu & sức khỏe phụ nữ":"","Vitamin & khoáng chất":"","Xương khớp":"","Làm đẹp từ bên trong":"","Sống khỏe năng động":"","default":""}

# --- Lịch đăng (giờ Việt Nam)
SLOTS_FACEBOOK=11:30,20:30
SLOTS_PINTEREST=13:00,21:00
AUTO_APPROVE=false

# --- Webhook từ WordPress / n8n
WEBHOOK_SECRET=doi-chuoi-bi-mat-nay

# --- Thông báo (tùy chọn)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
