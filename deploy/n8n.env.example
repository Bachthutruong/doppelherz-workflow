# /opt/dh-robot/n8n.env (chmod 640, owner root:dhrobot)
HOME=/opt/dh-robot/n8n-home
N8N_USER_FOLDER=/opt/dh-robot/n8n-home
N8N_PORT=5678
N8N_LISTEN_ADDRESS=127.0.0.1
GENERIC_TIMEZONE=Asia/Ho_Chi_Minh
TZ=Asia/Ho_Chi_Minh
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_SECURE_COOKIE=false
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
ROBOT_URL=http://127.0.0.1:8141
ROBOT_PUBLIC_URL=https://doppelherz-workflow.jiudi.cloud
ROBOT_WEBHOOK_SECRET=same-value-as-WEBHOOK_SECRET-in-robot-env
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
