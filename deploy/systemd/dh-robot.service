[Unit]
Description=Doppelherz Content Robot - dashboard + API
After=network.target

[Service]
User=dhrobot
Group=dhrobot
WorkingDirectory=/opt/dh-robot/app
EnvironmentFile=/opt/dh-robot/.env
ExecStart=/opt/dh-robot/venv/bin/uvicorn content_robot.web:app_factory --factory --host 127.0.0.1 --port 8141 --proxy-headers
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
